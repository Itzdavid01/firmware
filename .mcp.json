{
  "mcpServers": {
    "meshtastic": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/meshtastic/meshtastic-mcp",
        "meshtastic-mcp"
      ],
      "env": {
        "MESHTASTIC_FIRMWARE_ROOT": ".",
        "MESHTASTIC_UI_CAMERA_DEVICE": "1",
        "MESHTASTIC_UI_CAMERA_BACKEND": "opencv"
      }
    }
  }
}
